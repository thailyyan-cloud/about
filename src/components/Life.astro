---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const corners = (await getCollection('corners')).sort((a, b) => a.data.order - b.data.order);
const entries = await getCollection('entries');
const itemsOf = (slug: string) => entries.filter((e) => e.id.split('/')[0] === slug);
const photosOf = (slug: string) => itemsOf(slug).filter((e) => e.data.image).length;

// The first two corners get the big photo tiles; the rest are small tiles.
const layout = ['wide-tall', 'wide', 'small', 'small'];
const now = itemsOf('now')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);
---

<section id="life" class="container" aria-labelledby="life-title">
  <div class="section-head">
    <p class="eyebrow">Outside the lab</p>
    <h2 id="life-title">A bit of my life.</h2>
  </div>

  <div class="bento">
    {
      corners.map((c, i) => {
        const n = photosOf(c.id);
        const size = layout[i] ?? 'small';
        return (
          <a class={`tile ${size} rise`} href={`${base}/me/${c.id}/`}>
            {c.data.cover ? (
              <Image
                src={c.data.cover}
                alt=""
                widths={[480, 960]}
                sizes="(min-width: 900px) 520px, 100vw"
                class="bg"
              />
            ) : (
              <span class="glyph">
                <Glyph name={c.data.icon} size={56} />
              </span>
            )}
            <span class="shade" />
            <span class="content">
              <span class="title">{c.data.title}</span>
              {c.id === 'now' ? (
                <ul class="now">
                  {now.map((e) => (
                    <li>{e.data.title}</li>
                  ))}
                </ul>
              ) : (
                <span class="tagline">{c.data.tagline}</span>
              )}
              <span class="more">{n > 0 ? `${n} photos →` : 'Open →'}</span>
            </span>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 236px;
    }
    .tile {
      min-height: 0;
    }
    .wide-tall {
      grid-column: span 2;
      grid-row: span 2;
    }
    .wide {
      grid-column: span 2;
    }
    .small {
      grid-column: span 1;
    }
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    min-height: 220px;
    display: flex;
    isolation: isolate;
    transition: border-color 0.2s, transform 0.2s;
  }
  .tile:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .tile :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile:hover :global(.bg) {
    transform: scale(1.05);
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 35%, rgba(7, 8, 11, 0.85));
  }
  .glyph {
    position: absolute;
    top: 18px;
    right: 18px;
    color: var(--accent);
    opacity: 0.9;
  }
  .content {
    margin-top: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .wide-tall .title {
    font-size: 1.7rem;
  }
  .tagline {
    color: rgba(238, 241, 245, 0.75);
    font-size: 14px;
    line-height: 1.45;
  }
  .more {
    margin-top: 6px;
    font-size: 13px;
    color: var(--accent);
  }
  .now {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    font-size: 13.5px;
    color: rgba(238, 241, 245, 0.8);
  }
  .now li {
    margin: 0 0 3px;
    padding-left: 14px;
    position: relative;
  }
  .now li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
