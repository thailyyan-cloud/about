---
// Every figure below is read from the project's own result files; see the Projects section for context.
const stats = [
  ['48.9 %', 'background dependence cut, no accuracy loss', 'AquaVision-X'],
  ['7', 'architectures compared under one protocol', 'ShrimpVision'],
  ['56/57', 'offline mission checks passing', 'SkyTrack'],
  ['16', 'KPIs fixed before the hardware is built', 'SmartGate'],
];
---

<section aria-label="At a glance" class="glance">
  <p class="intro">
    I'm An. I split my time between training computer-vision models and wiring up the hardware they'll eventually run
    on, and I don't believe a result until I know why it works.
  </p>
  <dl class="grid">
    {
      stats.map(([n, label, from]) => (
        <div class="cell rise">
          <dt class="num mono">{n}</dt>
          <dd>
            <span class="label-txt">{label}</span>
            <span class="from mono">{from}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .intro {
    font-size: 1.18rem;
    line-height: 1.55;
    max-width: 58ch;
    margin: 0 0 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
  }
  .cell {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    background: var(--panel);
  }
  .num {
    font-size: 1.7rem;
    white-space: nowrap;
    line-height: 1.1;
    color: var(--warm);
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }
  dd {
    margin: 0;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.45;
  }
  .label-txt {
    display: block;
  }
  .from {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    color: var(--accent);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
