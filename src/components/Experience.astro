  {
    kind: 'Research',
    title: 'Student researcher · aquaculture computer vision',
    body: '2026 – present, under faculty supervision at IU. AquaVision-X (fish disease; results frozen Aug 2026) and ShrimpVision (shrimp disease; in progress). Python and PyTorch on Colab and Kaggle GPUs.',
  },
  {
    kind: 'Hackathon',
    title: 'SkyTrack drone hackathon prototype',
    body: 'Sep 2026. Two-tier crop-survey mission with a battery-aware guard, tested offline against a mock drone adapter.',
  },
  {
    kind: 'Education',
    title: 'International University, VNU-HCM',
    body: 'Major: Electronics & Telecommunications Engineering, 3rd year. Thesis: SmartGate edge-AI access control, build planned for 2028.',
  },
  {
    kind: 'Collaboration',
    title: 'Robot Solving Cube · EPHEC University, Belgium',
    body: 'March 2025. Worked with electrical-electronics students from EPHEC on a cube-solving robot project.',
  },
  {
    kind: 'Team project',
    title: 'Drone prototypes · Electrical-Electronics Dept.',
    body: 'Designed, assembled and programmed remote-controlled drone models; tested further prototypes beyond the coursework.',
  },
  {
    kind: 'Award',
    title: 'Merit-based scholarship',
    body: 'Semester II, Academic Year 2024–2025.',
  },
