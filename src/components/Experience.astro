---

<section id="experience" aria-labelledby="experience-title">
  <h2 class="label" id="experience-title"><span class="no">03</span> experience</h2>
  <ol class="timeline">
    {
      entries.map((e) => (
        <li>
          <span class="kind mono">{e.kind}</span>
          <div>
            <h3>{e.title}</h3>
            <p class="muted">{e.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="direction">
    <span class="mono">Direction:</span> IoT, embedded systems and embedded AI (on-device computer vision).
  </p>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline {
    border-left: 1px solid var(--line);
    margin-left: 4px;
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 14px 0 14px 22px;
    margin: 0;
  }
  /* node on the line */
  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 21px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--accent);
    transition: background 0.15s;
  }
  .timeline li:hover::before {
    background: var(--accent);
  }
  .kind {
    font-size: 12.5px;
    color: var(--accent);
    padding-top: 3px;
  }
  .timeline h3 {
    font-size: 1rem;
    margin-bottom: 2px;
  }
  .timeline p {
    margin: 0;
    font-size: 15px;
  }
  .direction {
    margin: 20px 0 0;
    font-size: 15px;
  }

  @media (max-width: 560px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 2px;
      padding-left: 18px;
    }
  }
</style>
