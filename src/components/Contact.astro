<section id="contact" class="container" aria-labelledby="contact-title">
  <div class="card rise">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Say hi.</h2>
    <p class="muted">Happy to chat about IoT, embedded AI, planes, or your cactus collection. Email reaches me fastest.</p>
    <div class="links">
      <a class="btn primary" href="mailto:thailyyan@gmail.com">thailyyan@gmail.com <span class="arrow">→</span></a>
      <a class="btn" href="https://www.instagram.com/lyanz_/">Instagram</a>
      <a class="btn" href="https://github.com/thailyyan-cloud">GitHub</a>
    </div>
  </div>
</section>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid var(--line);
    padding: clamp(28px, 6vw, 64px);
    background: radial-gradient(70% 120% at 100% 0%, rgba(167, 139, 250, 0.16), transparent 60%),
      radial-gradient(60% 100% at 0% 100%, rgba(94, 234, 212, 0.12), transparent 60%), var(--card);
  }
  h2 {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }
  .muted {
    color: var(--muted);
    max-width: 44ch;
    font-size: 1.08rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
</style>
