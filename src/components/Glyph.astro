---
// Line-art placeholders in the blueprint style. They inherit color from CSS (currentColor).
interface Props {
  name: 'cactus' | 'fish' | 'travel' | 'now' | 'generic';
  size?: number;
}
const { name, size = 64 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'cactus' && (
      <>
        <path d="M34 88h52v7H34z" />
        <path d="M38 95l5 18h34l5-18" />
        <path d="M52 88V38a8 8 0 0 1 16 0v50" />
        <path d="M52 68h-8a6 6 0 0 1-6-6V50a4 4 0 0 1 8 0v8h6" />
        <path d="M68 60h8a6 6 0 0 0 6-6V44a4 4 0 0 0-8 0v8h-6" />
        <path d="M60 34v-4M56 50l-3-2M64 56l3-2M57 74l-3 2M63 80l3 2" opacity=".7" />
      </>
    )
  }
  {
    name === 'fish' && (
      <>
        <path d="M18 60c18-24 56-26 76 0-20 26-58 24-76 0z" />
        <path d="M94 60l16-14-4 14 4 14z" />
        <path d="M54 39l8-11 7 13" />
        <circle cx="34" cy="55" r="3" />
        <path d="M21 63l4 3 4-3 4 3 4-3" />
        <path d="M60 60c4-6 4-12 0-18M70 62c3-5 3-10 0-15" opacity=".6" />
      </>
    )
  }
  {
    name === 'travel' && (
      <>
        <circle cx="84" cy="34" r="10" />
        <path d="M12 86l30-36 18 22 14-14 34 28" />
        <path d="M10 100q10-6 20 0t20 0 20 0 20 0 20 0" />
        <path d="M18 110q10-6 20 0t20 0 20 0 20 0" opacity=".6" />
      </>
    )
  }
  {
    name === 'now' && (
      <>
        <circle cx="60" cy="60" r="34" />
        <circle cx="60" cy="60" r="20" />
        <circle cx="60" cy="60" r="5" />
        <path d="M60 14v16M60 90v16M14 60h16M90 60h16" />
      </>
    )
  }
  {
    name === 'generic' && (
      <>
        <rect x="22" y="22" width="76" height="76" rx="6" />
        <path d="M60 44v32M44 60h32" />
      </>
    )
  }
</svg>
