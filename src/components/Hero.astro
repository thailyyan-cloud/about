---
import portrait from '../assets/portrait.webp';
import CircuitBg from './CircuitBg.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The basics first, like the first page of a datasheet.
const specs = [
  ['Major', 'Electronics & Telecommunications Engineering'],
  ['School', 'International University, VNU-HCM · 3rd year'],
  ['Based in', 'Ho Chi Minh City, Vietnam'],
  ['Focus', 'IoT · Embedded systems · Embedded AI'],
  ['Interests', 'Cacti · Predatory fish · Travel'],
  ['Goal', 'Aircraft maintenance engineer'],
];
---

<section id="about" class="hero-wrap" aria-labelledby="hero-title">
  <CircuitBg />
  <div class="hero container">
    <div class="text">
      <p class="eyebrow enter" style="--i:0">About me</p>
      <h1 id="hero-title" class="enter" style="--i:1">Hi, I'm <span class="grad">An.</span></h1>

      <dl class="specs">
        {
          specs.map(([k, v], i) => (
            <div class="enter" style={`--i:${i + 2}`}>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <p class="intro enter" style={`--i:${specs.length + 2}`}>
        I'm curious, a little stubborn, and happiest when I finally get why something works. Off the clock I grow cacti,
        keep fish that bite, and look for waterfalls.
      </p>

      <div class="cta enter" style={`--i:${specs.length + 3}`}>
        <a class="btn primary" href={`${base}/me/#projects`} data-open-projects>See my projects <span class="arrow">→</span></a>
        <a class="btn" href={`${base}/me/cv/`}>View my CV</a>
      </div>
    </div>

    <div class="photo enter" style="--i:1">
      <div class="frame">
        <img
          src={portrait.src}
          width="640"
          height="960"
          alt="Portrait of Thái Lý An in a white shirt"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <p class="links">
        <a href="mailto:thailyyan@gmail.com">Email</a>
        <a href="https://www.instagram.com/lyanz_/">Instagram</a>
        <a href="https://github.com/thailyyan-cloud">GitHub</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero-wrap {
    position: relative;
    isolation: isolate;
    padding-top: 0;
    overflow: hidden; /* the circuit art is wider than the viewport on purpose */
  }
  .hero {
    display: grid;
    gap: 28px;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 24px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 64px;
      padding-top: 96px;
    }
  }
  h1 {
    font-size: clamp(2.8rem, 8vw, 4.8rem);
    letter-spacing: -0.045em;
    margin: 0 0 26px;
  }
  .grad {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* the datasheet */
  .specs {
    margin: 0;
    border-top: 1px solid var(--line);
    max-width: 560px;
  }
  .specs div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .specs dt {
    font: 500 11.5px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 3px;
  }
  .specs dd {
    margin: 0;
    color: var(--fg);
    font-size: 15.5px;
  }

  .intro {
    margin: 22px 0 28px;
    max-width: 52ch;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .photo {
    order: -1;
    width: 168px;
  }
  @media (min-width: 900px) {
    .photo {
      order: 0;
      width: 300px;
      justify-self: center;
    }
  }
  .frame {
    border-radius: 28px;
    padding: 1px;
    background: linear-gradient(160deg, rgba(94, 234, 212, 0.6), rgba(167, 139, 250, 0.5) 50%, transparent 85%);
    box-shadow: 0 30px 80px -20px rgba(94, 234, 212, 0.25);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: 27px;
  }
  .links {
    display: none;
    justify-content: center;
    gap: 20px;
    margin: 18px 0 0;
    font-size: 14px;
    color: var(--dim);
  }
  .links a:hover {
    color: var(--fg);
  }
  @media (min-width: 900px) {
    .links {
      display: flex;
    }
  }
</style>
