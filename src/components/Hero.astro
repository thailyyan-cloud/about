---
import portrait from '../assets/portrait.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="text">
    <p class="pill"><span class="dot"></span> Electronics &amp; Telecommunications Engineering · IU, VNU-HCM</p>
    <h1 id="hero-title">Hi, I'm <span class="grad">An.</span></h1>
    <p class="lead">
      Third-year engineering student in Ho Chi Minh City. I build small devices that can see, and one day I want to
      keep real aircraft flying.
    </p>
    <div class="cta">
      <a class="btn primary" href={`${base}/me/#projects`} data-open-projects>See my projects <span class="arrow">→</span></a>
      <a class="btn" href={`${base}/me/cv/`}>View my CV</a>
    </div>
    <p class="socials">
      <a href="mailto:thailyyan@gmail.com">Email</a>
      <a href="https://www.instagram.com/lyanz_/">Instagram</a>
      <a href="https://github.com/thailyyan-cloud">GitHub</a>
    </p>
  </div>

  <div class="photo">
    <div class="frame">
      <img
        src={portrait.src}
        width="640"
        height="960"
        alt="Portrait of Thái Lý An in a white shirt"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <p class="badge"><span class="dot"></span> Currently: IoT &amp; embedded AI</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 20px;
    align-items: center;
    padding-top: 40px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.25fr 0.75fr;
      padding-top: 112px;
      gap: 64px;
    }
  }
  h1 {
    font-size: clamp(3rem, 9vw, 5.6rem);
    margin: 22px 0 18px;
    letter-spacing: -0.045em;
  }
  .grad {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.55;
    color: var(--muted);
    max-width: 34ch;
    margin-bottom: 30px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .socials {
    display: flex;
    gap: 20px;
    margin-top: 26px;
    font-size: 14px;
    color: var(--dim);
  }
  .socials a:hover {
    color: var(--fg);
  }

  .photo {
    position: relative;
    justify-self: start;
    width: 180px;
    order: -1;
    margin-bottom: 12px;
  }
  @media (min-width: 900px) {
    .photo {
      justify-self: center;
      width: 320px;
      order: 0;
      margin-bottom: 0;
    }
  }
  .frame {
    position: relative;
    border-radius: 28px;
    padding: 1px;
    background: linear-gradient(160deg, rgba(94, 234, 212, 0.6), rgba(167, 139, 250, 0.5) 50%, transparent 85%);
    box-shadow: 0 30px 80px -20px rgba(94, 234, 212, 0.25);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: 27px;
  }
  /* the floating "Currently" badge only fits beside the large desktop photo */
  .badge {
    display: none;
    position: absolute;
    left: 50%;
    bottom: -18px;
    transform: translateX(-50%);
    margin: 0;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    background: rgba(13, 15, 20, 0.85);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  @media (min-width: 900px) {
    .badge {
      display: inline-flex;
    }
  }
</style>
