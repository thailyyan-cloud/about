---
// GitHub Pages serves this file for any path that doesn't exist.
import Layout from '../layouts/Layout.astro';
import Glyph from '../components/Glyph.astro';
---

<Layout title="Page not found · Thái Lý An" description="Nothing to see here.">
  <section class="container nf" aria-labelledby="nf-title">
    <span class="glyph enter" style="--i:0"><Glyph name="now" size={56} /></span>
    <p class="code enter" style="--i:1">404 · no signal</p>
    <h1 id="nf-title" class="enter" style="--i:2">Nothing to see here.</h1>
    <p class="muted enter" style="--i:3">The link might be old, or a typo snuck in. Let's get you back.</p>
    <p class="cta enter" style="--i:4">
      <a class="btn primary" href="/about/me/">Go to the home page <span class="arrow">→</span></a>
      <a class="btn" href="/about/me/cv/">View my CV</a>
    </p>
  </section>
</Layout>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    align-content: center;
    justify-items: start;
    padding-top: 80px;
  }
  .glyph {
    color: var(--accent);
    margin-bottom: 18px;
  }
  .code {
    font: 500 13px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }
  .muted {
    color: var(--muted);
    max-width: 48ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
  }
</style>
