---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Glyph from '../../components/Glyph.astro';

export async function getStaticPaths() {
  const corners = await getCollection('corners');
  return corners.map((corner) => ({ params: { corner: corner.id }, props: { corner } }));
}

const { corner } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content: Intro } = await render(corner);

// order (if set) first, then newest date, then title
const items = (await getCollection('entries'))
  .filter((e) => e.id.split('/')[0] === corner.id)
  .sort(
    (a, b) =>
      (a.data.order ?? 1e9) - (b.data.order ?? 1e9) ||
      (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) ||
      a.data.title.localeCompare(b.data.title)
  );
const rendered = await Promise.all(items.map(async (e) => ({ e, Body: (await render(e)).Content })));

const others = (await getCollection('corners'))
  .filter((c) => c.id !== corner.id)
  .sort((a, b) => a.data.order - b.data.order);
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
const icon = corner.data.icon;
---

<Layout title={`${corner.data.title} · Thái Lý An`} description={corner.data.tagline}>
  <Hero slot="side" />

  <section aria-labelledby="corner-title">
    <p class="crumb mono"><a href={`${base}/me/`}>~/me</a> <span aria-hidden="true">/</span> {corner.id}</p>
    <div class="head">
      <span class="glyph"><Glyph name={icon} size={52} /></span>
      <div>
        <h1 id="corner-title">{corner.data.title}</h1>
        <p class="tagline">{corner.data.tagline}</p>
      </div>
    </div>
    <div class="prose intro"><Intro /></div>

    {
      rendered.length === 0 ? (
        <div class="empty">
          <Glyph name={icon} size={72} />
          <p class="mono">Photos coming soon.</p>
        </div>
      ) : (
        <div class="grid">
          {rendered.map(({ e, Body }) => (
            <article class="item rise">
              {e.data.image ? (
                <Image
                  src={e.data.image}
                  alt={e.data.imageAlt ?? e.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 1000px) 340px, (min-width: 640px) 45vw, 100vw"
                  class="photo"
                />
              ) : (
                <div class="ph">
                  <Glyph name={icon} size={56} />
                  <span class="mono">photo coming soon</span>
                </div>
              )}
              <div class="txt">
                <header>
                  <h2>{e.data.title}</h2>
                  {e.data.status && <span class="status warm">{e.data.status}</span>}
                </header>
                {e.data.date && <p class="date mono">{fmt.format(e.data.date)}</p>}
                <div class="prose">
                  <Body />
                </div>
                {e.data.tags.length > 0 && (
                  <ul class="tags">
                    {e.data.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section aria-labelledby="more-title">
    <h2 class="label" id="more-title"><span class="no">··</span> more corners</h2>
    <p class="more">
      {
        others.map((c) => (
          <a href={`${base}/me/${c.id}/`}>
            <Glyph name={c.data.icon} size={20} />
            {c.data.title}
          </a>
        ))
      }
      <a href={`${base}/me/`}>← back to ~/me</a>
    </p>
  </section>
</Layout>

<style>
  .crumb {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .crumb a {
    color: var(--accent);
  }
  .head {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 18px;
  }
  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    color: var(--accent);
    border: 1px dashed var(--line);
    border-radius: 10px;
    background: var(--panel);
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    letter-spacing: -0.02em;
  }
  .tagline {
    color: var(--muted);
    margin: 4px 0 0;
  }
  .intro {
    max-width: 62ch;
    font-size: 1.05rem;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 26px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .item {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }
  .item:hover {
    border-color: var(--accent);
  }
  .item :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ph {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 10px;
    color: var(--accent);
    background: linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 16px 16px, var(--bg);
    border-bottom: 1px dashed var(--line);
  }
  .ph span {
    font-size: 11px;
    color: var(--muted);
  }
  .txt {
    padding: 14px 16px 16px;
  }
  .txt header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .txt h2 {
    font-size: 1.05rem;
  }
  .date {
    font-size: 11.5px;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .txt .prose {
    font-size: 14.5px;
    color: var(--muted);
  }

  .empty {
    margin-top: 26px;
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 40px 20px;
    display: grid;
    place-items: center;
    gap: 12px;
    color: var(--accent);
    background: var(--panel);
  }
  .empty p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 14px;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .more :global(svg) {
    color: var(--accent);
  }
</style>
