---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Glyph from '../../components/Glyph.astro';

export async function getStaticPaths() {
  const corners = await getCollection('corners');
  return corners.map((corner) => ({ params: { corner: corner.id }, props: { corner } }));
}

const { corner } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content: Intro } = await render(corner);

// order (if set) first, then newest date, then title
const items = (await getCollection('entries'))
  .filter((e) => e.id.split('/')[0] === corner.id)
  .sort(
    (a, b) =>
      (a.data.order ?? 1e9) - (b.data.order ?? 1e9) ||
      (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) ||
      a.data.title.localeCompare(b.data.title)
  );
const rendered = await Promise.all(items.map(async (e) => ({ e, Body: (await render(e)).Content })));
const photos = rendered.filter(({ e }) => e.data.image);
const notes = rendered.filter(({ e }) => !e.data.image);

const others = (await getCollection('corners'))
  .filter((c) => c.id !== corner.id)
  .sort((a, b) => a.data.order - b.data.order);
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short' });
const icon = corner.data.icon;
---

<Layout title={`${corner.data.title} · Thái Lý An`} description={corner.data.tagline}>
  <section class="container page" aria-labelledby="corner-title">
    <a class="back" href={`${base}/me/#life`}>← Back</a>
    <header class="head">
      <span class="glyph"><Glyph name={icon} size={40} /></span>
      <div>
        <h1 id="corner-title">{corner.data.title}</h1>
        <p class="tagline">{corner.data.tagline}</p>
      </div>
    </header>
    <div class="intro"><Intro /></div>

    {
      photos.length > 0 && (
        <div class="gallery">
          {photos.map(({ e, Body }) => (
            <figure class="shot rise">
              <Image
                src={e.data.image!}
                alt={e.data.imageAlt ?? e.data.title}
                widths={[480, 960]}
                sizes="(min-width: 900px) 500px, 100vw"
              />
              <figcaption>
                <span class="t">{e.data.title}</span>
                {e.data.date && <span class="d">{fmt.format(e.data.date)}</span>}
                <span class="b">
                  <Body />
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      notes.length > 0 && (
        <div class="notes">
          {notes.map(({ e, Body }) => (
            <article class="note rise">
              <div class="top">
                <h2>{e.data.title}</h2>
                {e.data.status && <span class="status">{e.data.status}</span>}
              </div>
              <div class="b">
                <Body />
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      items.length === 0 && (
        <div class="empty">
          <Glyph name={icon} size={64} />
          <p>Photos coming soon.</p>
        </div>
      )
    }

    <nav class="more" aria-label="Other pages">
      {
        others.map((c) => (
          <a href={`${base}/me/${c.id}/`}>
            <Glyph name={c.data.icon} size={18} /> {c.data.title}
          </a>
        ))
      }
    </nav>
  </section>
</Layout>

<style>
  .page {
    padding-top: 40px;
  }
  .back {
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--fg);
  }
  .head {
    display: flex;
    gap: 18px;
    align-items: center;
    margin: 28px 0 18px;
  }
  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    color: var(--accent);
    background: var(--card);
    border: 1px solid var(--line);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    letter-spacing: -0.04em;
  }
  .tagline {
    margin: 6px 0 0;
    color: var(--muted);
  }
  .intro {
    max-width: 60ch;
    font-size: 1.08rem;
    color: var(--muted);
  }
  .intro :global(a) {
    color: var(--accent);
  }

  /* a plain grid keeps the reading order (columns would reorder top-to-bottom) */
  .gallery {
    margin-top: 36px;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 680px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
  .shot {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .shot:hover :global(img) {
    transform: scale(1.03);
  }
  figcaption {
    padding: 12px 16px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
  }
  .t {
    font-weight: 600;
  }
  .d {
    font-size: 12.5px;
    color: var(--dim);
  }
  .b {
    flex-basis: 100%;
    color: var(--muted);
    font-size: 14px;
  }
  .b :global(p) {
    margin: 4px 0 0;
  }

  .notes {
    margin-top: 32px;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 680px) {
    .notes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .note {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    background: var(--card);
  }
  .note .top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
  }
  .note h2 {
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .empty {
    margin-top: 36px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 56px 20px;
    display: grid;
    place-items: center;
    gap: 12px;
    color: var(--accent);
  }
  .empty p {
    margin: 0;
    color: var(--muted);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 56px;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .more a:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .more :global(svg) {
    color: var(--accent);
  }
</style>
