---
import '@fontsource-variable/inter';
import '../styles/global.css';
import circuitTile from '../assets/circuit-tile.svg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Set in the repo as an Actions variable (Settings -> Variables -> GOATCOUNTER_CODE).
// Only a plausible site code is accepted; the literal template placeholder "CODE" is ignored.
const rawCode: string = (import.meta.env.PUBLIC_GOATCOUNTER_CODE ?? '').trim();
const goatcounter = /^[a-z0-9-]+$/i.test(rawCode) && rawCode.toUpperCase() !== 'CODE' ? rawCode : '';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!-- Entrance animations only hide content when JS is running; without JS everything shows. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="bg-circuit" aria-hidden="true" style={`--tile: url(${circuitTile.src})`}></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container">
        <a class="logo" href={`${base}/about/me/`}>Thái Lý An<span>.</span></a>
        <nav class="nav-links" aria-label="Primary">
          <a href={`${base}/about/me/#projects`} data-open-projects>Projects</a>
          <a class="hide-sm" href={`${base}/about/me/#life`}>Life</a>
          <a href={`${base}/about/me/cv/`}>CV</a>
          <a class="hide-sm" href={`${base}/about/me/#contact`}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="container">
        <span>© {year} Thái Lý An · Ho Chi Minh City</span>
        <span>
          Built with Astro{goatcounter && ' · visits counted with GoatCounter, no cookies'}{' · '}<a
            href="https://github.com/thailyyan-cloud/about">source</a
          >
        </span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Reveal sections as they scroll into view.
        var els = document.querySelectorAll('.rise');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        } else {
          els.forEach(function (el) {
            el.classList.add('in');
          });
        }

        // Projects open in a dialog on the home page; elsewhere the link navigates to /me/#projects.
        var dlg = document.getElementById('projects-dialog');
        function open() {
          if (dlg && !dlg.open) dlg.showModal();
        }
        if (dlg) {
          document.querySelectorAll('[data-open-projects]').forEach(function (el) {
            el.addEventListener('click', function (e) {
              e.preventDefault();
              open();
              history.replaceState(null, '', '#projects');
            });
          });
          dlg.addEventListener('click', function (e) {
            if (e.target === dlg) dlg.close(); // click on the backdrop
          });
          dlg.addEventListener('close', function () {
            if (location.hash === '#projects') history.replaceState(null, '', location.pathname);
          });
          document.querySelectorAll('[data-close-dialog]').forEach(function (b) {
            b.addEventListener('click', function () {
              dlg.close();
            });
          });
          if (location.hash === '#projects') open();
        }
        // pointer glow: fine pointers only, and not with reduced motion
        var mq = window.matchMedia;
        if (mq && mq('(pointer: fine)').matches && !mq('(prefers-reduced-motion: reduce)').matches) {
          var root = document.documentElement;
          addEventListener(
            'pointermove',
            function (e) {
              root.style.setProperty('--mx', e.clientX + 'px');
              root.style.setProperty('--my', e.clientY + 'px');
            },
            { passive: true }
          );
        }
      })();
    </script>
    {
      goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
